{
  "name": "@junior/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared test helpers (workplan C2): jsdom layout stubs, provider SSE wire builders, CLI stream-json fixtures, fake UIMessages, OpenAI-compatible mock. Test-only — never imported by app code.",
  "exports": {
    "./jsdom": {
      "types": "./dist/jsdom-layout.d.ts",
      "default": "./dist/jsdom-layout.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "default": "./dist/wire.js"
    },
    "./cli-stream": {
      "types": "./dist/cli-stream.d.ts",
      "default": "./dist/cli-stream.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "default": "./dist/chat.js"
    },
    "./openai-mock": {
      "types": "./dist/openai-mock.d.ts",
      "default": "./dist/openai-mock.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ai": "7.0.151"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
